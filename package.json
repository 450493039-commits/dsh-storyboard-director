{
  "name": "dsh-storyboard-director",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Seedance 分镜导演台（题材通用全功能版）：随包提供题材通用的 Seedance 2.0 分镜生成 skill（风格自选：写实/动画/水墨/科幻…，内置「上美影」风格预设）与五个题材示范项目，用即梦官方 CLI（dreamina-canvas）出图、出片、拼接成片；剧本/资产/分镜格式自检（drama_check）；侧栏「分镜导演台」工作台与生成历史持久化。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lab",
    "lib",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "seedance",
    "dreamina",
    "jimeng",
    "storyboard",
    "short-drama",
    "director"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "license": "MIT"
}
